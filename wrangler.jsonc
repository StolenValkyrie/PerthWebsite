{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "perthwebsite",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/auth/*", "/dashboard"]
  },
  "vars": {
    "DISCORD_CLIENT_ID": "1566068953191555102",
    "GUILD_ID": "1566066035084234762"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "perth-roleplay",
      "database_id": "ac75454a-2726-43e5-80c2-5c33178ef209"
    }
  ]
}